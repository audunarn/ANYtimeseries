+name: indexed rainflow tests
+on:
+  pull_request:
+  push:
+    branches: [main]
+permissions:
+  contents: read
+jobs:
+  indexed:
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, windows-latest]
+        python: ['3.8', '3.11', '3.14']
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python }}
+      - name: Install headless numerical dependencies
+        run: python -m pip install numpy scipy matplotlib pytest setuptools wheel
+      - name: Test indexed core and frozen legacy fixtures
+        run: python -m pytest -q tests/test_indexed_rainflow.py
+      - name: Test existing fatigue helper
+        if: matrix.python != '3.8'
+        run: python -m pytest -q tests/test_fatigue_tool.py
