+@pytest.mark.parametrize('chunk', [0,-1,1.5,True,'3'])
+def test_invalid_chunk_size(chunk):
+    with pytest.raises(ValueError, match='chunk_size'): count_cycles_indexed([0,1,0],chunk_size=chunk)
